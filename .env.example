# Copy this file to .env.local (for Vercel) or .env (for Netlify dev)
# and fill in your real values. NEVER commit real keys to git.

# Which AI provider server/ai powers the app with. Defaults to
# "anthropic" if unset. Switching this (plus its provider-specific
# vars below) is the only change needed to run on a different model —
# no application code changes required.
AI_PROVIDER=anthropic

# --- anthropic provider ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # only needed for identity-linked keys

# --- openai provider (also covers self-hosted OpenAI-compatible
#     runtimes like Ollama, vLLM, or LM Studio — just point
#     OPENAI_BASE_URL at them instead) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
